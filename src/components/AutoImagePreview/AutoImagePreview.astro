---
import "./styles.css";

interface Props {
  images: string[];
  alt: string;
  transition?: "fade" | "slide" | "collapse";
  interval?: number
}

const { images, alt, transition = "fade", interval = 800 } = Astro.props;
---

<div class:list={["auto-image-preview", `transition-${transition}`]} data-interval={interval}>
  {
    images.map((image, index) => (
      <img
        src={image}
        alt={index === 0 ? alt : ""}
        aria-hidden={index !== 0}
        class:list={["auto-image", { active: index === 0 }]}
      />
    ))
  }
</div>

<script>
  import "./script.ts";
</script>
