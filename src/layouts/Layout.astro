---
import "../styles/global.css";
import Sidebar from "./Sidebar.astro";

interface Props {
  title?: string;
}

const { title = "Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Nattha's Portfolio" />

    <title>{title}</title>
  </head>

  <body>
    <div class="portfolio-layout">
      <Sidebar />

      <main class="content">
        <slot />
      </main>
    </div>
  </body>
  <script>
    import "../scripts/parallaxImage.ts";
  </script>
</html>
