---
import {
  faBriefcase,
  faGraduationCap,
  faBullhorn,
  faFileDownload,
} from "@fortawesome/free-solid-svg-icons";
import Icon from "../../../../components/Icon.astro";

const items = [
  {
    id: "introduction",
    label: "INTRODUCTION",
    icon: faBullhorn,
  },
  {
    id: "experience",
    label: "EXPERIENCE",
    icon: faBriefcase,
  },
  {
    id: "education",
    label: "EDUCATION",
    icon: faGraduationCap,
  },
];
---

<nav class="navigator" aria-label="Main navigation">
  {
    items.map((item) => (
      <a class="navigator-button" href={`#${item.id}`} data-nav={item.id}>
        <Icon iconData={item.icon} />
        <span class="navigator-button-text">{item.label}</span>
      </a>
    ))
  }

  <a
    class="navigator-button navigator-resume"
    href="/public/resume.pdf"
    download
  >
    <Icon iconData={faFileDownload} />
    <span>RESUME</span>
  </a>
</nav>
