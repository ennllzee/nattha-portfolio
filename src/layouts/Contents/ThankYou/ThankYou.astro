---
import { faFileDownload } from "@fortawesome/free-solid-svg-icons";
import "./styles.css";
import FloatingCircle from "../../../components/FloatingCircle/FloatingCircle.astro";
import Icon from "../../../components/Icon.astro";
---

<section id="thank-you" class="thank-you" data-section="thank-you">
  <div class="thank-you-intro">
    <h2>THANK YOU</h2>

    <p>Thank you for taking the time to explore my work.</p>
  </div>

  <div class="thank-you-bottom">
    <a class="resume-button" href="nattha-resume.pdf" download>
      <Icon iconData={faFileDownload} />
      <strong>Get my resume here</strong>
    </a>

    <p class="thank-you-quote">
      <strong><em>Always ready for a new challenge.</em></strong>
    </p>
  </div>

  <FloatingCircle
    color="var(--warm-yellow)"
    size={120}
    anchorX="left"
    anchorY="top"
  />
  <FloatingCircle
    color="var(--deep-blue)"
    size={160}
    anchorX="right"
    anchorY="center"
  />
  <FloatingCircle
    color="var(--coral-red)"
    size={200}
    anchorX="center"
    anchorY="bottom"
  />
</section>
