---
import Contacts from "../../components/Contacts/Contacts.astro";
import "./styles.css";
---

<aside class="sidebar">
  <div class="sidebar-card">
    <div class="sidebar-heading">
      <h1 class="portfolio-title">PORTFOLIO</h1>
      <p class="sidebar-name">NATTHA CHAIYARIN</p>
      <p class="sidebar-job-title">SOFTWARE ENGINEER</p>
    </div>

    <div class="profile-container">
      <div class="profile-circle"></div>

      <img
        class="profile-image"
        src=import.meta.env.BASE_URL + "/images/profile-transparent.png"
        alt="Nattha"
      />
    </div>

    <div class="sidebar-contacts">
      <Contacts />
    </div>
  </div>
</aside>